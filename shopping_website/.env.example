# Optional configuration for Flask CLI. dev.py run sets these safely itself.
# Relative FESTO_DATA_DIR paths are relative to shopping_website/.
FESTO_DATA_DIR=.local-data
FESTO_OFFLINE=1
# Set a private random value before any non-demo deployment.
FESTO_SECRET_KEY=
# Only use a separate authorized test project for integration work.
SUPABASE_URL=
SUPABASE_KEY=
FESTO_DB_PATH=
